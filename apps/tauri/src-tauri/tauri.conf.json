{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trilium Notes (Tauri POC)",
  "version": "0.104.1",
  "identifier": "com.triliumnext.notes.poc",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Trilium Notes — Tauri POC",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "url": "http://localhost:8080"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}